{
  "name": "adminwebsite-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "generate:completed-projects": "node scripts/generate-completed-projects.mjs",
    "build": "pnpm --filter frontend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "deploy:backend": "pnpm --filter admin-api exec wrangler deploy",
    "deploy:frontend": "pnpm --filter frontend run build && pnpm --filter frontend exec wrangler pages deploy dist --project-name 180dc-admin-frontend",
    "deploy:all": "pnpm run deploy:backend && pnpm run deploy:frontend",
    "test": "node tests/run.mjs",
    "test:mail": "node tests/run.mjs --mail"
  },
  "devDependencies": {
    "turbo": "latest",
    "wrangler": "^3.114.17"
  }
}
