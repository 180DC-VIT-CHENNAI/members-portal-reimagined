{
  "name": "adminwebsite-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "test:proxy": "node --test apps/frontend/functions/_middleware.test.mjs",
    "test:origins": "node --test apps/admin-api/origin-policy.test.mjs",
    "test:sessions": "node --test apps/admin-api/session-security.test.mjs",
    "verify:local-origins": "node scripts/verify-local-origins.mjs",
    "verify:local-auth": "node scripts/verify-local-auth.mjs",
    "verify:local-projects": "node scripts/verify-local-projects.mjs",
    "verify:local-sessions": "node scripts/verify-local-sessions.mjs",
    "generate:completed-projects": "node scripts/generate-completed-projects.mjs",
    "build": "pnpm --filter frontend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "deploy:backend": "pnpm --filter admin-api exec wrangler deploy",
    "deploy:frontend": "pnpm --filter frontend run build && pnpm --filter frontend exec wrangler pages deploy dist --project-name 180dc-admin-frontend",
    "deploy:all": "pnpm run deploy:backend && pnpm run deploy:frontend",
    "test:clerk-identity": "node --test apps/admin-api/clerk-identity.test.mjs",
    "verify:local-clerk": "node scripts/verify-local-clerk.mjs",
    "test:rate-limits": "node --test apps/admin-api/rate-limit.test.mjs",
    "test:club-files": "node --test apps/admin-api/club-file-policy.test.mjs"
  },
  "devDependencies": {
    "turbo": "latest",
    "wrangler": "^3.114.17"
  }
}
