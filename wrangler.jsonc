// Reimagined deployment: ONE Worker on the personal Cloudflare account.
// - Frontend (apps/frontend/dist) is served as static assets. Asset requests,
//   including SPA navigations, never invoke the Worker and are not billed.
// - Only /api/* runs the Worker (apps/admin-api/index.ts).
// Workers Builds (repo root): build `pnpm run build`, deploy `npx wrangler deploy`.
// The club production deploy still uses apps/admin-api/wrangler.toml + Pages.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "members-portal-reimagined",
  "account_id": "ee4c08f37c3a62fedc87fbd1b8b96ff4",
  "main": "./apps/admin-api/index.ts",
  "compatibility_date": "2024-04-05",
  // assets_navigation_prefers_asset_serving: serve index.html for SPA
  // navigations without invoking the Worker (default only from 2025-04-01).
  "compatibility_flags": ["nodejs_compat", "assets_navigation_prefers_asset_serving"],
  "workers_dev": false,
  "preview_urls": true,
  // No routes: 180dc.vitcc.org moved to the 180dc-portal Worker (apps/portal).
  // Re-adding the custom domain here would take it back on the next deploy.
  "assets": {
    "directory": "./apps/frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "members-portal-reimagined-db", "database_id": "d0467c89-9c82-4366-b931-d2c9935631bc" },
    { "binding": "NEWSLETTER_DB", "database_name": "members-portal-reimagined-newsletter", "database_id": "f956078f-f083-40e0-b281-5a1867a8c5e6" }
  ],
  "r2_buckets": [
    { "binding": "CLUB_FILES", "bucket_name": "members-portal-reimagined-club-files" },
    { "binding": "BLOG_IMAGES", "bucket_name": "members-portal-reimagined-blog-images" },
    { "binding": "CASE_STUDIES", "bucket_name": "members-portal-reimagined-case-studies" },
    { "binding": "GALLERY_CDN", "bucket_name": "members-portal-reimagined-gallery" }
  ],
  // No KV and no Queue. Email cron intentionally off until mail secrets are set:
  // "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_WEB_ORIGINS": "https://180dc.vitcc.org",
    "NEWSLETTER_SITE_URL": "",
    "GOOGLE_CLIENT_ID": "79558531530-f32je33pig45b1t0beg4kji3nkgl224f.apps.googleusercontent.com",
    "B2_S3_ENDPOINT": "https://s3.eu-central-003.backblazeb2.com",
    "B2_BUCKET": "180dc-vitc"
  },
  // Worker Previews (Workers Builds runs `npx wrangler preview` for every
  // non-main branch). Previews never touch production data. Preview URLs are
  // public, so ENVIRONMENT stays "production" to keep dev-only routes off.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "members-portal-reimagined-preview-db", "database_id": "d6d1ec0a-fd57-4194-afba-652e02f13292" },
      { "binding": "NEWSLETTER_DB", "database_name": "members-portal-reimagined-preview-newsletter", "database_id": "4300430a-2675-4422-8796-e6b7485513b4" }
    ],
    "r2_buckets": [
      { "binding": "CLUB_FILES", "bucket_name": "members-portal-reimagined-preview-club-files" },
      { "binding": "BLOG_IMAGES", "bucket_name": "members-portal-reimagined-preview-blog-images" },
      { "binding": "CASE_STUDIES", "bucket_name": "members-portal-reimagined-preview-case-studies" },
      { "binding": "GALLERY_CDN", "bucket_name": "members-portal-reimagined-preview-gallery" }
    ],
    "vars": {
      "ENVIRONMENT": "production",
      "NEWSLETTER_SITE_URL": ""
    }
  }
  // Secrets (set in the dashboard or `wrangler secret put`): GOOGLE_CLIENT_SECRET,
  // SPACEMAIL_SMTP_USER, SPACEMAIL_SMTP_PASS, RESEND_API_KEY, GEMINI_API_KEY, GROQ_API_KEY,
  // B2_KEY_ID, B2_APPLICATION_KEY, B2_READ_KEY_ID, B2_READ_APPLICATION_KEY (docs/operations/BACKUP_B2.md).
}
